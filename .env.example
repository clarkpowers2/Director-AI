# Frontend (safe to expose — compiled into the browser bundle)
VITE_DIRECTORAI_API_URL=https://directorai.hccgsa.com

# Server-only secrets (never prefix these with VITE_ — VITE_* values are public in the built JS).
# Local dev: wrangler reads them from .dev.vars (or .env). Production/preview:
#   npx wrangler pages secret put HEYGEN_API_KEY --project-name directorai-web
HEYGEN_API_KEY=your_heygen_api_key_here
